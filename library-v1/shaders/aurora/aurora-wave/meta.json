{
  "$schema": "../../../schemas/shader-meta.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Aurora Wave",
  "slug": "aurora/aurora-wave",
  "category": "Aurora",
  "family": "Layered Sinusoidal Aurora",
  "author": "Jennipher Troup",
  "description": "Layered sinusoids and low-amplitude noise form a wide, sky-like auroral ribbon.",
  "tags": [
    "aurora",
    "wave",
    "sky",
    "banner",
    "ambient"
  ],
  "status": "stable",
  "renderer": {
    "api": "webgl2",
    "glslVersion": "300 es",
    "entryPoint": "main",
    "vertexContract": "fullscreen-quad-v_uv",
    "alphaMode": "opaque"
  },
  "uniforms": {
    "u_time": {
      "type": "float",
      "default": 1.2345,
      "ui": "hidden",
      "semanticRole": "animation-time"
    },
    "u_resolution": {
      "type": "vec2",
      "default": [
        512,
        512
      ],
      "ui": "hidden",
      "semanticRole": "viewport-size"
    },
    "u_mouse": {
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "ui": "hidden",
      "semanticRole": "pointer-position"
    },
    "speed": {
      "type": "float",
      "default": 0.6,
      "ui": "slider",
      "semanticRole": "speed",
      "min": 0,
      "max": 2,
      "step": 0.01
    },
    "amplitude": {
      "type": "float",
      "default": 0.85,
      "ui": "slider",
      "semanticRole": "amplitude",
      "min": 0,
      "max": 2,
      "step": 0.01
    }
  },
  "preview": {
    "image": "preview.png",
    "width": 512,
    "height": 512,
    "time": 1.2345,
    "seed": 42,
    "background": "#000000"
  },
  "compatibility": {
    "webgl2": true,
    "mobileTier": "medium",
    "reducedMotion": "freeze",
    "requiresTextures": false
  },
  "aliases": [
    "aurora/default",
    "aurora-wave"
  ],
  "usage": {
    "bestFor": [
      "wide banners",
      "sky backgrounds",
      "section dividers",
      "ambient hero fields"
    ],
    "avoidFor": [
      "long-form body text backgrounds",
      "accessibility-critical information without a static fallback"
    ]
  }
}
