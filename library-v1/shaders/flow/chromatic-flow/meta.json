{
  "$schema": "../../../schemas/shader-meta.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Chromatic Flow",
  "slug": "flow/chromatic-flow",
  "category": "Flow",
  "family": "Flow Field Dispersion",
  "author": "Jennipher Troup",
  "description": "A moving chromatic field that bends color channels through a directional flow lattice.",
  "tags": [
    "flow-field",
    "chromatic",
    "dispersion",
    "animated",
    "background"
  ],
  "status": "stable",
  "renderer": {
    "api": "webgl2",
    "glslVersion": "300 es",
    "entryPoint": "main",
    "vertexContract": "fullscreen-quad-v_uv",
    "alphaMode": "opaque"
  },
  "uniforms": {
    "u_time": {
      "type": "float",
      "default": 1.2345,
      "ui": "hidden",
      "semanticRole": "animation-time"
    },
    "u_resolution": {
      "type": "vec2",
      "default": [
        512,
        512
      ],
      "ui": "hidden",
      "semanticRole": "viewport-size"
    },
    "u_mouse": {
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "ui": "hidden",
      "semanticRole": "pointer-position"
    },
    "flowScale": {
      "type": "float",
      "default": 2.8,
      "ui": "slider",
      "semanticRole": "flowScale",
      "min": 0.25,
      "max": 8,
      "step": 0.05
    },
    "dispersion": {
      "type": "float",
      "default": 0.7,
      "ui": "slider",
      "semanticRole": "dispersion",
      "min": 0,
      "max": 2,
      "step": 0.01
    }
  },
  "preview": {
    "image": "preview.png",
    "width": 512,
    "height": 512,
    "time": 1.2345,
    "seed": 42,
    "background": "#000000"
  },
  "compatibility": {
    "webgl2": true,
    "mobileTier": "medium",
    "reducedMotion": "freeze",
    "requiresTextures": false
  },
  "aliases": [
    "fluid-psychedelic/chromatic-flow",
    "chromatic-flow"
  ],
  "usage": {
    "bestFor": [
      "animated backgrounds",
      "transitions",
      "music visuals",
      "full-bleed sections"
    ],
    "avoidFor": [
      "long-form body text backgrounds",
      "accessibility-critical information without a static fallback"
    ]
  }
}
