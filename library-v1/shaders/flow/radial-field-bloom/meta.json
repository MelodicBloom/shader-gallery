{
  "$schema": "../../../schemas/shader-meta.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Radial Field Bloom",
  "slug": "flow/radial-field-bloom",
  "category": "Flow",
  "family": "Stateless Radial Flow Recurrence",
  "author": "Jennipher Troup",
  "description": "A controllable radial flow study that advects a seeded color density field through a stateless recurrence approximation; it does not sample prior frames or model physical bloom.",
  "tags": [
    "radial",
    "flow-field",
    "vortex",
    "seeded",
    "procedural",
    "animated"
  ],
  "status": "experimental",
  "renderer": {
    "api": "webgl2",
    "glslVersion": "300 es",
    "entryPoint": "main",
    "vertexContract": "fullscreen-quad-v_uv",
    "alphaMode": "opaque"
  },
  "uniforms": {
    "u_time": {
      "type": "float",
      "default": 1.2345,
      "ui": "hidden",
      "semanticRole": "animation-time"
    },
    "u_resolution": {
      "type": "vec2",
      "default": [
        512,
        512
      ],
      "ui": "hidden",
      "semanticRole": "viewport-size"
    },
    "u_mouse": {
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "ui": "hidden",
      "semanticRole": "pointer-position"
    },
    "seed": {
      "type": "float",
      "default": 42,
      "ui": "slider",
      "semanticRole": "seed",
      "min": 0,
      "max": 65535,
      "step": 1
    },
    "radialFrequency": {
      "type": "float",
      "default": 5.4,
      "ui": "slider",
      "semanticRole": "radialFrequency",
      "min": 0.5,
      "max": 12,
      "step": 0.05
    },
    "vortexStrength": {
      "type": "float",
      "default": 0.9,
      "ui": "slider",
      "semanticRole": "vortexStrength",
      "min": 0,
      "max": 2,
      "step": 0.01
    },
    "feedbackAmount": {
      "type": "float",
      "default": 0.42,
      "ui": "slider",
      "semanticRole": "statelessRecurrenceAmplitude",
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "paletteA": {
      "type": "vec3",
      "default": [
        0.06,
        0.15,
        0.35
      ],
      "ui": "color",
      "semanticRole": "paletteA"
    },
    "paletteB": {
      "type": "vec3",
      "default": [
        0.15,
        0.82,
        0.72
      ],
      "ui": "color",
      "semanticRole": "paletteB"
    },
    "paletteC": {
      "type": "vec3",
      "default": [
        0.98,
        0.36,
        0.54
      ],
      "ui": "color",
      "semanticRole": "paletteC"
    }
  },
  "preview": {
    "image": "preview.png",
    "width": 512,
    "height": 512,
    "time": 1.2345,
    "seed": 42,
    "background": "#000000"
  },
  "compatibility": {
    "webgl2": true,
    "mobileTier": "medium",
    "reducedMotion": "freeze",
    "requiresTextures": false
  },
  "aliases": [
    "radial-field-bloom",
    "flow/radial-bloom"
  ],
  "usage": {
    "bestFor": [
      "animated backgrounds",
      "music visuals",
      "transitions",
      "ambient radial accents"
    ],
    "avoidFor": [
      "long-form body text backgrounds",
      "accessibility-critical information without a static fallback",
      "effects that require temporal feedback"
    ]
  }
}
