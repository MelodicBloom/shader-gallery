{
  "$schema": "../../../schemas/shader-meta.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Euphoric Glow",
  "slug": "glow/euphoric-glow",
  "category": "Glow",
  "family": "Hue-Cycled Bloom",
  "author": "Jennipher Troup",
  "description": "A saturated, color-cycling radial glow for calls to action, ambient accents, and energetic focal points.",
  "tags": [
    "glow",
    "bloom",
    "hue",
    "euphoric",
    "accent"
  ],
  "status": "stable",
  "renderer": {
    "api": "webgl2",
    "glslVersion": "300 es",
    "entryPoint": "main",
    "vertexContract": "fullscreen-quad-v_uv",
    "alphaMode": "opaque"
  },
  "uniforms": {
    "u_time": {
      "type": "float",
      "default": 1.2345,
      "ui": "hidden",
      "semanticRole": "animation-time"
    },
    "u_resolution": {
      "type": "vec2",
      "default": [
        512,
        512
      ],
      "ui": "hidden",
      "semanticRole": "viewport-size"
    },
    "u_mouse": {
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "ui": "hidden",
      "semanticRole": "pointer-position"
    },
    "glow": {
      "type": "float",
      "default": 1.35,
      "ui": "slider",
      "semanticRole": "glow",
      "min": 0,
      "max": 4,
      "step": 0.01
    },
    "hueShift": {
      "type": "float",
      "default": 0.1,
      "ui": "slider",
      "semanticRole": "hueShift",
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  },
  "preview": {
    "image": "preview.png",
    "width": 512,
    "height": 512,
    "time": 1.2345,
    "seed": 42,
    "background": "#000000"
  },
  "compatibility": {
    "webgl2": true,
    "mobileTier": "medium",
    "reducedMotion": "freeze",
    "requiresTextures": false
  },
  "aliases": [
    "euphoric-glow/default"
  ],
  "usage": {
    "bestFor": [
      "accent glows",
      "callouts",
      "button halos",
      "energetic focal points"
    ],
    "avoidFor": [
      "long-form body text backgrounds",
      "accessibility-critical information without a static fallback"
    ]
  }
}
