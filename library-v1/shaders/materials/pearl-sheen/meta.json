{
  "$schema": "../../../schemas/shader-meta.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Pearl Sheen",
  "slug": "materials/pearl-sheen",
  "category": "Materials",
  "family": "Soft Fresnel Sheen",
  "author": "Jennipher Troup",
  "description": "A soft nacre-like color ramp with restrained Fresnel response for cards, shells, and quiet luminous surfaces.",
  "tags": [
    "pearl",
    "nacre",
    "fresnel",
    "soft",
    "luminous"
  ],
  "status": "stable",
  "renderer": {
    "api": "webgl2",
    "glslVersion": "300 es",
    "entryPoint": "main",
    "vertexContract": "fullscreen-quad-v_uv",
    "alphaMode": "opaque"
  },
  "uniforms": {
    "u_time": {
      "type": "float",
      "default": 1.2345,
      "ui": "hidden",
      "semanticRole": "animation-time"
    },
    "u_resolution": {
      "type": "vec2",
      "default": [
        512,
        512
      ],
      "ui": "hidden",
      "semanticRole": "viewport-size"
    },
    "u_mouse": {
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "ui": "hidden",
      "semanticRole": "pointer-position"
    },
    "baseColor": {
      "type": "vec3",
      "default": [
        0.76,
        0.82,
        0.96
      ],
      "ui": "color",
      "semanticRole": "baseColor"
    },
    "sheen": {
      "type": "float",
      "default": 0.72,
      "ui": "slider",
      "semanticRole": "sheen",
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  },
  "preview": {
    "image": "preview.png",
    "width": 512,
    "height": 512,
    "time": 1.2345,
    "seed": 42,
    "background": "#000000"
  },
  "compatibility": {
    "webgl2": true,
    "mobileTier": "medium",
    "reducedMotion": "freeze",
    "requiresTextures": false
  },
  "aliases": [
    "pearl/default"
  ],
  "usage": {
    "bestFor": [
      "card overlays",
      "panels",
      "pearlescent accents",
      "quiet hero surfaces"
    ],
    "avoidFor": [
      "long-form body text backgrounds",
      "accessibility-critical information without a static fallback"
    ]
  }
}
