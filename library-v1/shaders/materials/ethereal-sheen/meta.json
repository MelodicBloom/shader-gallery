{
  "$schema": "../../../schemas/shader-meta.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Ethereal Sheen",
  "slug": "materials/ethereal-sheen",
  "category": "Materials",
  "family": "Thin-Film Noise Sheen",
  "author": "Jennipher Troup",
  "description": "A polished finishing layer combining angular interference, soft grain, and restrained spectral sheen.",
  "tags": [
    "ethereal",
    "sheen",
    "thin-film",
    "grain",
    "polish"
  ],
  "status": "stable",
  "renderer": {
    "api": "webgl2",
    "glslVersion": "300 es",
    "entryPoint": "main",
    "vertexContract": "fullscreen-quad-v_uv",
    "alphaMode": "opaque"
  },
  "uniforms": {
    "u_time": {
      "type": "float",
      "default": 1.2345,
      "ui": "hidden",
      "semanticRole": "animation-time"
    },
    "u_resolution": {
      "type": "vec2",
      "default": [
        512,
        512
      ],
      "ui": "hidden",
      "semanticRole": "viewport-size"
    },
    "u_mouse": {
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "ui": "hidden",
      "semanticRole": "pointer-position"
    },
    "sheen": {
      "type": "float",
      "default": 0.72,
      "ui": "slider",
      "semanticRole": "sheen",
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "detail": {
      "type": "float",
      "default": 0.35,
      "ui": "slider",
      "semanticRole": "detail",
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  },
  "preview": {
    "image": "preview.png",
    "width": 512,
    "height": 512,
    "time": 1.2345,
    "seed": 42,
    "background": "#000000"
  },
  "compatibility": {
    "webgl2": true,
    "mobileTier": "medium",
    "reducedMotion": "freeze",
    "requiresTextures": false
  },
  "aliases": [
    "ethereal-sheen/default"
  ],
  "usage": {
    "bestFor": [
      "hero polish",
      "surface finishing",
      "premium cards",
      "lightweight overlays"
    ],
    "avoidFor": [
      "long-form body text backgrounds",
      "accessibility-critical information without a static fallback"
    ]
  }
}
