{
  "$schema": "../../../schemas/shader-meta.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Soap Bubble",
  "slug": "materials/soap-bubble",
  "category": "Materials",
  "family": "Membrane Interference",
  "author": "Jennipher Troup",
  "description": "Animated membrane bands with organic perturbation for bubbles, floating lenses, and playful micro-interactions.",
  "tags": [
    "bubble",
    "membrane",
    "noise",
    "iridescent",
    "playful"
  ],
  "status": "stable",
  "renderer": {
    "api": "webgl2",
    "glslVersion": "300 es",
    "entryPoint": "main",
    "vertexContract": "fullscreen-quad-v_uv",
    "alphaMode": "straight"
  },
  "uniforms": {
    "u_time": {
      "type": "float",
      "default": 1.2345,
      "ui": "hidden",
      "semanticRole": "animation-time"
    },
    "u_resolution": {
      "type": "vec2",
      "default": [
        512,
        512
      ],
      "ui": "hidden",
      "semanticRole": "viewport-size"
    },
    "u_mouse": {
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "ui": "hidden",
      "semanticRole": "pointer-position"
    },
    "speed": {
      "type": "float",
      "default": 0.7,
      "ui": "slider",
      "semanticRole": "speed",
      "min": 0,
      "max": 2,
      "step": 0.01
    },
    "bandWidth": {
      "type": "float",
      "default": 0.055,
      "ui": "slider",
      "semanticRole": "bandWidth",
      "min": 0.01,
      "max": 0.2,
      "step": 0.005
    }
  },
  "preview": {
    "image": "preview.png",
    "width": 512,
    "height": 512,
    "time": 1.2345,
    "seed": 42,
    "background": "#000000"
  },
  "compatibility": {
    "webgl2": true,
    "mobileTier": "medium",
    "reducedMotion": "freeze",
    "requiresTextures": false
  },
  "aliases": [
    "soap-bubble/default"
  ],
  "usage": {
    "bestFor": [
      "floating bubbles",
      "UI micro-interactions",
      "circular masks",
      "ambient ornaments"
    ],
    "avoidFor": [
      "long-form body text backgrounds",
      "accessibility-critical information without a static fallback"
    ]
  }
}
