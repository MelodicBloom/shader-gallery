{
  "$schema": "../../../schemas/shader-meta.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Labradorite Schiller",
  "slug": "materials/labradorite-schiller",
  "category": "Materials",
  "family": "Oriented internal plates",
  "author": "Jennipher Troup",
  "description": "Blue and turquoise sweep across dark mineral plates as the viewing angle changes. Experimental appearance study.",
  "tags": [
    "3d",
    "view-dependent",
    "optical-study"
  ],
  "status": "experimental",
  "renderer": {
    "api": "webgl2",
    "glslVersion": "300 es",
    "entryPoint": "main",
    "vertexContract": "fullscreen-quad-v_uv",
    "alphaMode": "straight"
  },
  "uniforms": {
    "u_time": {
      "type": "float",
      "default": 0,
      "ui": "hidden",
      "semanticRole": "light-sweep-time"
    },
    "u_resolution": {
      "type": "vec2",
      "default": [
        512,
        512
      ],
      "ui": "hidden",
      "semanticRole": "viewport-size"
    },
    "cameraOrbit": {
      "type": "vec3",
      "default": [
        0.35,
        0.18,
        3.4
      ],
      "ui": "hidden",
      "semanticRole": "camera-yaw-pitch-distance"
    },
    "lightDirection": {
      "type": "vec3",
      "default": [
        0,
        0,
        0
      ],
      "ui": "hidden",
      "semanticRole": "optional-world-space-key-light"
    },
    "grain": {
      "type": "float",
      "default": 0.48,
      "ui": "slider",
      "semanticRole": "Layer detail",
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "paletteShift": {
      "type": "float",
      "default": 0.32,
      "ui": "slider",
      "semanticRole": "Color bias",
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "spectral": {
      "type": "float",
      "default": 0.62,
      "ui": "slider",
      "semanticRole": "Color strength",
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "roughness": {
      "type": "float",
      "default": 0.26,
      "ui": "slider",
      "semanticRole": "Roughness",
      "min": 0.08,
      "max": 0.8,
      "step": 0.01
    }
  },
  "preview": {
    "image": "preview.png",
    "width": 512,
    "height": 512,
    "time": 0,
    "seed": 42,
    "background": "#080c12"
  },
  "compatibility": {
    "webgl2": true,
    "mobileTier": "unmeasured",
    "reducedMotion": "freeze-light",
    "requiresTextures": false
  },
  "modelBoundary": {
    "evidenceClass": "HYPOTHESIS",
    "calibrated": false,
    "color": "authored RGB proxies",
    "subsurfaceScattering": false,
    "closedVolumeRefraction": false,
    "causticTransport": false,
    "roughRefraction": false
  },
  "controlLabels": {
    "grain": "Layer detail",
    "paletteShift": "Color bias",
    "spectral": "Color strength",
    "roughness": "Roughness"
  }
}
