{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://shader-grammar.dev/v0.1/field.schema.json",
  "title": "Shader Grammar Field Catalog", "type": "object", "additionalProperties": false,
  "required": ["ontologyVersion", "fields"],
  "properties": { "ontologyVersion": { "const": "0.1" }, "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } } },
  "$defs": {
    "port": { "type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {
      "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "type": { "enum": ["float", "vec2", "vec3", "vec4", "color", "spectrum", "mat2", "mat3"] }, "optional": { "type": "boolean" }
    }},
    "field": { "type": "object", "additionalProperties": false,
      "required": ["id", "label", "category", "domain", "codomain", "definition", "inputs", "continuity", "sampling", "representations", "cost"],
      "properties": {
        "id": { "type": "string", "pattern": "^field\\.[a-z][a-z0-9_]*$" }, "label": { "type": "string", "minLength": 1 },
        "category": { "enum": ["coordinate", "geometric", "procedural", "simulation", "optical", "volumetric", "temporal"] },
        "domain": { "enum": ["uv", "surface", "object", "world", "volume", "time"] },
        "codomain": { "enum": ["float", "vec2", "vec3", "vec4", "color", "spectrum", "mat2", "mat3"] },
        "definition": { "type": "string", "minLength": 1 }, "inputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "parameterDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "continuity": { "enum": ["discontinuous", "C0", "C1", "C2", "smooth", "distribution"] },
        "sampling": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": {
          "mode": { "enum": ["analytic", "texture", "procedural", "simulation", "raymarch"] }, "bandLimitRequired": { "type": "boolean" }
        }},
        "representations": { "type": "object", "additionalProperties": false, "required": ["glsl", "wgsl"], "properties": { "glsl": { "type": "string" }, "wgsl": { "type": "string" } } },
        "cost": { "enum": ["negligible", "low", "medium", "high"] }
      }
    }
  }
}
